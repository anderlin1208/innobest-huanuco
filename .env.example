# Sustituye la URI por la que te entrega MongoDB Atlas.
# Si la contraseña incluye @ : / ? # [ ] debe codificarse para URL.
# Nunca compartas este archivo cuando tenga credenciales reales.
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=innobest_huanuco
# Opcional: para cámara remota robusta (configurar como variables privadas en Render).
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_KEY_API_TOKEN=
# INNOBEST_CPU_THREADS=1
